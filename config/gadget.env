# USB descriptor settings. The default VID/PID are suitable only for private
# prototyping. Use an assigned VID/PID before distributing a product.
USB_VENDOR_ID=0x1d6b
USB_PRODUCT_ID=0x0104
USB_BCD_DEVICE=0x0200
USB_MANUFACTURER="Tractus"
USB_PRODUCT="Tractus USB Audio Matrix"
# Leave empty to derive a stable serial number from /proc/cpuinfo.
USB_SERIAL=""
# Increment this suffix when Windows must discard cached USB interface names.
USB_SERIAL_SUFFIX="-v2"
# Read channel friendly names from the router configuration at gadget startup.
# Custom descriptor sets add a stable name hash to the USB serial so Windows
# does not reuse cached endpoint names. A rename therefore creates a new host
# device instance and may require app/default-device selections to be updated.
USB_NAMES_FROM_ROUTER=1
USB_SERIAL_INCLUDE_NAMES_HASH=1
ROUTER_CONFIG="/home/tractus/.config/pi-usb-audio/router.json"
CONTROL_APP="/opt/pi-usb-audio/PiUsbAudio.Control"

GADGET_NAME=pi-usb-audio
GADGET_COUNT=4
SAMPLE_RATE=48000
# Names are from the Pi/ALSA side: playback is Pi-to-Windows microphone;
# capture is Windows-to-Pi speaker audio. Signed 16-bit at 48 kHz is the most
# broadly interoperable format and avoids packed 24-bit packet corruption.
PLAYBACK_SAMPLE_SIZE_BYTES=2
CAPTURE_SAMPLE_SIZE_BYTES=2
# Additional queued USB requests per stream improve scheduling tolerance.
REQUEST_COUNT=64
# Four async endpoints would exceed the Pi 4 DWC2 IN-endpoint budget because
# each one needs a feedback endpoint.
CAPTURE_SYNC=adaptive
